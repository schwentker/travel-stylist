{
  "name": "travel-stylist",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "sandboxlabs.ai/travel-stylist", "zone_name": "sandboxlabs.ai" },
    { "pattern": "sandboxlabs.ai/travel-stylist/", "zone_name": "sandboxlabs.ai" },
    { "pattern": "sandboxlabs.ai/travel-stylist/styles.css", "zone_name": "sandboxlabs.ai" },
    { "pattern": "sandboxlabs.ai/travel-stylist/app.js", "zone_name": "sandboxlabs.ai" },
    { "pattern": "sandboxlabs.ai/travel-stylist/sponsored.js", "zone_name": "sandboxlabs.ai" },
    { "pattern": "sandboxlabs.ai/travel-stylist/sponsored-ads.js", "zone_name": "sandboxlabs.ai" },
    { "pattern": "sandboxlabs.ai/travel-stylist/api/*", "zone_name": "sandboxlabs.ai" }
  ],
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": true },
  "containers": [{
    "class_name": "Stylist",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "./Dockerfile" } }
  }],
  "durable_objects": { "bindings": [
    { "name": "STYLIST", "class_name": "Stylist" },
    { "name": "DATABASE", "class_name": "TripDatabase" }
  ] },
  "exports": {
    "Stylist": { "type": "durable-object", "storage": "sqlite" },
    "TripDatabase": { "type": "durable-object", "storage": "sqlite" }
  }
}
